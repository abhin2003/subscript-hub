# ==============================================================================
# Subscript Hub - Environment Configuration (.env.example)
# Derived from Implementation Plan (BP §6, §16 & SL §1-§25)
# ==============================================================================

# Application & Environment
APP_NAME="Subscript Hub"
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# Ports & Hosts
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5173
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Database Configuration (PostgreSQL 16)
# When running via Docker Compose use host 'db'; when running locally use 'localhost'
DB_HOST=localhost
DB_PORT=5432
DB_NAME=subscript_hub
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/subscript_hub
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/subscript_hub

# Security & Authentication (Argon2id + JWT)
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars_long_entropy_seed
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# CORS Settings (Allowed Frontend Origins as JSON array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# Mail & Notifications (Mailpit for local development, SMTP for production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=False
SMTP_SSL=False
EMAIL_FROM="Brightloop Software <billing@brightloop.io>"
NOTIFICATION_MAX_ATTEMPTS=5

# Billing Engine & Worker Schedules (APScheduler in Asia/Kolkata timezone)
BILLING_CRON_SCHEDULE="0 2 * * *"       # Daily at 02:00 IST
LIFECYCLE_SWEEP_CRON="0 1 * * *"       # Daily at 01:00 IST
OVERDUE_REMINDERS_CRON="0 9 * * *"     # Daily at 09:00 IST
NOTIFICATION_DISPATCH_SECONDS=60       # Every 60 seconds
DEFAULT_PAYMENT_TERMS_DAYS=15
DEFAULT_VALIDITY_DAYS=30
AUTO_CONFIRM_INVOICES=False
AUTO_PAID_ZERO_INVOICES=True

# Rate Limiting
LOGIN_RATE_LIMIT="5/15minutes"
FORGOT_PASSWORD_RATE_LIMIT="3/hour"

# Initial Seed Credentials (for scripts/seed.py)
SEED_ADMIN_EMAIL=admin@brightloop.io
SEED_ADMIN_PASSWORD=Admin123!Secure
SEED_ADMIN_NAME="Brightloop Administrator"

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_URL=http://localhost:8000/api/v1
VITE_USE_MOCKS=false
VITE_APP_NAME="Subscript Hub"
